# Скопируйте файл в .env и вставьте токен из платформы MAX для партнёров.
MAX_BOT_TOKEN=replace_me

# MAX user ID специалистов через запятую. Только эти пользователи видят общую очередь заявок.
SPECIALIST_USER_IDS=

# Необязательно. По умолчанию: .data/phone_verifications.sqlite3
PHONE_VERIFICATION_DB=.data/phone_verifications.sqlite3

# PostgreSQL для запуска через Docker Compose.
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Локальный HTTP-порт mini app. Для подключения в MAX нужен публичный HTTPS URL.
MINI_APP_PORT=8080

# Постоянное доменное имя для серверного HTTPS-развёртывания.
MINI_APP_DOMAIN=213-171-9-160.sslip.io

# Ключ авторизации проекта GigaChat API. Не добавляйте настоящий ключ в git.
GIGACHAT_CREDENTIALS=replace_me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# Необязательно. По умолчанию используется certs/russiantrustedca.pem.
GIGACHAT_CA_BUNDLE=certs/russiantrustedca.pem
GIGACHAT_TIMEOUT=90
